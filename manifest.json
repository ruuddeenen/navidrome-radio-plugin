{
  "name": "Navidrome Radio Plugin",
  "author": "Ruud Deenen",
  "version": "0.2.0",
  "description": "Periodically syncs internet radio stations from radio-browser.info into Navidrome, with configurable cron, name template and filters.",
  "website": "https://github.com/ruuddeenen/navidrome-radio-plugin",
  "config": {
    "schema": {
      "type": "object",
      "properties": {
        "sync_cron": {
          "type": "string",
          "title": "Sync-planning (cron)",
          "description": "Cron-expressie: minuut uur dag maand weekdag (bijv. '30 1 * * *' = dagelijks 01:30).",
          "default": "30 1 * * *"
        },
        "dry_run": {
          "type": "boolean",
          "title": "Dry run",
          "description": "Alleen berekenen en loggen, niets aanpassen in Navidrome.",
          "default": false
        },
        "name_template": {
          "type": "string",
          "title": "Naam-template",
          "description": "Bepaalt de zendernaam. Placeholders: {name} {url} {url_resolved} {homepage} {favicon} {tags} {tag} {countrycode} {country} {countrysubdivisioncode} {countrysubdivision} {language} {languages} {languagecodes} {codec} {geoinfo}, plus elk ruw Radio-Browser-veld. Gebruik {veld?:standaard} voor een terugval. Lege haakjes zoals [] worden verwijderd.",
          "default": "[{countrycode?:OTHER}] [{tags}] {name}"
        },
        "hide_broken": {
          "type": "boolean",
          "title": "Kapotte zenders verbergen",
          "description": "Alleen zenders die op dit moment bereikbaar zijn (Radio-Browser lastcheckok).",
          "default": true
        },
        "countrycodes_mode": {
          "type": "string",
          "title": "Landcodes",
          "description": "Filter op ISO-landcode. Kies 'Uitsluiten' of 'Alleen deze'.",
          "default": "exclude",
          "oneOf": [
            {
              "const": "exclude",
              "title": "Uitsluiten"
            },
            {
              "const": "include",
              "title": "Alleen deze"
            }
          ]
        },
        "countrycodes": {
          "type": "string",
          "title": "Landcodes",
          "description": "Bijv. 'NL, DE, BE'. Komma-gescheiden. Leeg = geen filter."
        },
        "tags_mode": {
          "type": "string",
          "title": "Tags",
          "description": "Filter op genre-tags.",
          "default": "exclude",
          "oneOf": [
            {
              "const": "exclude",
              "title": "Uitsluiten"
            },
            {
              "const": "include",
              "title": "Alleen deze"
            }
          ]
        },
        "tags": {
          "type": "string",
          "title": "Tags",
          "description": "Bijv. 'jazz, classical'. Komma-gescheiden. Leeg = geen filter."
        },
        "languagecodes_mode": {
          "type": "string",
          "title": "Taalcodes",
          "description": "Filter op taalcode.",
          "default": "exclude",
          "oneOf": [
            {
              "const": "exclude",
              "title": "Uitsluiten"
            },
            {
              "const": "include",
              "title": "Alleen deze"
            }
          ]
        },
        "languagecodes": {
          "type": "string",
          "title": "Taalcodes",
          "description": "Bijv. 'en, nl'. Komma-gescheiden. Leeg = geen filter."
        },
        "codecs_mode": {
          "type": "string",
          "title": "Codecs",
          "description": "Filter op audiocodec.",
          "default": "exclude",
          "oneOf": [
            {
              "const": "exclude",
              "title": "Uitsluiten"
            },
            {
              "const": "include",
              "title": "Alleen deze"
            }
          ]
        },
        "codecs": {
          "type": "string",
          "title": "Codecs",
          "description": "Bijv. 'mp3, aac'. Komma-gescheiden. Leeg = geen filter."
        },
        "min_bitrate": {
          "type": "string",
          "title": "Minimum bitrate",
          "description": "Sla zenders met een lagere bitrate over.",
          "default": "0",
          "oneOf": [
            {
              "const": "0",
              "title": "Geen minimum"
            },
            {
              "const": "32",
              "title": "32 kbps"
            },
            {
              "const": "48",
              "title": "48 kbps"
            },
            {
              "const": "64",
              "title": "64 kbps"
            },
            {
              "const": "96",
              "title": "96 kbps"
            },
            {
              "const": "128",
              "title": "128 kbps"
            },
            {
              "const": "160",
              "title": "160 kbps"
            },
            {
              "const": "192",
              "title": "192 kbps"
            },
            {
              "const": "224",
              "title": "224 kbps"
            },
            {
              "const": "256",
              "title": "256 kbps"
            },
            {
              "const": "320",
              "title": "320 kbps"
            }
          ]
        },
        "min_votes": {
          "type": "integer",
          "title": "Minimum votes",
          "description": "Sla zenders met minder stemmen over. 0 = geen minimum.",
          "default": 0
        },
        "require_countrycode": {
          "type": "boolean",
          "title": "Landcode vereist",
          "description": "Sla zenders zonder landcode over.",
          "default": false
        },
        "require_homepage": {
          "type": "boolean",
          "title": "Homepage vereist",
          "description": "Sla zenders zonder homepage over. De webspeler haalt het favicon-logo van de homepage.",
          "default": false
        },
        "require_geo": {
          "type": "boolean",
          "title": "Geo-coördinaten vereist",
          "description": "Sla zenders zonder geo-coördinaten over.",
          "default": false
        },
        "prune_missing": {
          "type": "boolean",
          "title": "Niet-passende zenders verwijderen",
          "description": "Verwijdert zenders die niet meer in de gefilterde set zitten. De plugin beheert de hele radiolijst.",
          "default": true
        }
      },
      "required": []
    },
    "uiSchema": {
      "type": "VerticalLayout",
      "elements": [
        {
          "type": "Group",
          "label": "Synchronisatie",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/sync_cron"
            },
            {
              "type": "Control",
              "scope": "#/properties/dry_run"
            }
          ]
        },
        {
          "type": "Group",
          "label": "Naamgeving",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/name_template",
              "options": {
                "multi": true
              }
            }
          ]
        },
        {
          "type": "Group",
          "label": "Filters",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/hide_broken"
            },
            {
              "type": "HorizontalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/countrycodes_mode"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/countrycodes"
                }
              ]
            },
            {
              "type": "HorizontalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/tags_mode"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/tags"
                }
              ]
            },
            {
              "type": "HorizontalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/languagecodes_mode"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/languagecodes"
                }
              ]
            },
            {
              "type": "HorizontalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/codecs_mode"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/codecs"
                }
              ]
            },
            {
              "type": "HorizontalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/min_bitrate"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/min_votes"
                }
              ]
            }
          ]
        },
        {
          "type": "Group",
          "label": "Vereisten",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/require_countrycode"
            },
            {
              "type": "Control",
              "scope": "#/properties/require_homepage"
            },
            {
              "type": "Control",
              "scope": "#/properties/require_geo"
            }
          ]
        },
        {
          "type": "Group",
          "label": "Gedrag",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/prune_missing"
            }
          ]
        }
      ]
    }
  },
  "permissions": {
    "http": {
      "reason": "Fetch stations from radio-browser.info.",
      "requiredHosts": [
        "de1.api.radio-browser.info",
        "de2.api.radio-browser.info",
        "nl1.api.radio-browser.info",
        "at1.api.radio-browser.info",
        "fr1.api.radio-browser.info",
        "all.api.radio-browser.info",
        "*.radio-browser.info"
      ]
    },
    "kvstore": {
      "reason": "Persist sync progress and the station ID mapping.",
      "maxSize": "64MB"
    },
    "scheduler": {
      "reason": "Run the periodic radio sync."
    },
    "taskqueue": {
      "reason": "Process stations in the background with retries.",
      "maxConcurrency": 2
    },
    "subsonicapi": {
      "reason": "Create, update and delete internet radio stations."
    },
    "users": {
      "reason": "Authorize the internal Subsonic API calls."
    }
  }
}
