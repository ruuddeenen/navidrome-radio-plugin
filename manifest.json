{
  "name": "Automatic Radio Sync",
  "author": "Ruud Deenen",
  "version": "0.3.0",
  "description": "Periodically syncs internet radio stations from radio-browser.info into Navidrome, with configurable cron, name template and filters.",
  "website": "https://github.com/ruuddeenen/navidrome-radio-sync-plugin",
  "config": {
    "schema": {
      "type": "object",
      "properties": {
        "sync_cron": {
          "type": "string",
          "title": "Sync schedule (cron)",
          "description": "Cron expression: minute hour day month weekday (e.g. '30 1 * * *' = daily at 01:30).",
          "default": "30 1 * * *"
        },
        "dry_run": {
          "type": "boolean",
          "title": "Dry run",
          "description": "Only compute and log, do not change anything in Navidrome.",
          "default": false
        },
        "sync_now": {
          "type": "boolean",
          "title": "Sync now (one-time)",
          "description": "Runs a one-time sync after the plugin loads (i.e. after saving settings). The plugin records that it ran, so it does not run again on the next load; toggle off and on again to trigger another run. Note: the switch cannot reset itself because plugin settings are read-only from within the plugin.",
          "default": false
        },
        "name_template": {
          "type": "string",
          "title": "Name template",
          "description": "Builds the station name. Placeholders: {name} {url} {url_resolved} {homepage} {favicon} {tags} {tag} {countrycode} {country} {countrysubdivisioncode} {countrysubdivision} {language} {languages} {languagecodes} {codec} {geoinfo}, plus any raw Radio-Browser field. Use {field?:default} for a fallback. Empty bracket groups such as [] are removed.",
          "default": "[{countrycode?:OTHER}] [{tags}] {name}"
        },
        "hide_broken": {
          "type": "boolean",
          "title": "Hide broken stations",
          "description": "Only include stations that are currently reachable (Radio-Browser lastcheckok).",
          "default": true
        },
        "countrycodes_mode": {
          "type": "string",
          "title": "Country codes",
          "description": "Filter by ISO country code.",
          "default": "exclude",
          "oneOf": [
            {
              "const": "exclude",
              "title": "Exclude"
            },
            {
              "const": "include",
              "title": "Include only"
            }
          ]
        },
        "countrycodes": {
          "type": "string",
          "title": "Country codes",
          "description": "e.g. 'NL, DE, BE'. Comma-separated. Empty = no filter."
        },
        "tags_mode": {
          "type": "string",
          "title": "Tags",
          "description": "Filter by genre tags.",
          "default": "exclude",
          "oneOf": [
            {
              "const": "exclude",
              "title": "Exclude"
            },
            {
              "const": "include",
              "title": "Include only"
            }
          ]
        },
        "tags": {
          "type": "string",
          "title": "Tags",
          "description": "e.g. 'jazz, classical'. Comma-separated. Empty = no filter."
        },
        "languagecodes_mode": {
          "type": "string",
          "title": "Language codes",
          "description": "Filter by language code.",
          "default": "exclude",
          "oneOf": [
            {
              "const": "exclude",
              "title": "Exclude"
            },
            {
              "const": "include",
              "title": "Include only"
            }
          ]
        },
        "languagecodes": {
          "type": "string",
          "title": "Language codes",
          "description": "e.g. 'en, nl'. Comma-separated. Empty = no filter."
        },
        "codecs_mode": {
          "type": "string",
          "title": "Codecs",
          "description": "Filter by audio codec.",
          "default": "exclude",
          "oneOf": [
            {
              "const": "exclude",
              "title": "Exclude"
            },
            {
              "const": "include",
              "title": "Include only"
            }
          ]
        },
        "codecs": {
          "type": "string",
          "title": "Codecs",
          "description": "e.g. 'mp3, aac'. Comma-separated. Empty = no filter."
        },
        "min_bitrate": {
          "type": "string",
          "title": "Minimum bitrate",
          "description": "Skip stations with a lower bitrate.",
          "default": "0",
          "oneOf": [
            {
              "const": "0",
              "title": "No minimum"
            },
            {
              "const": "32",
              "title": "32 kbps"
            },
            {
              "const": "48",
              "title": "48 kbps"
            },
            {
              "const": "64",
              "title": "64 kbps"
            },
            {
              "const": "96",
              "title": "96 kbps"
            },
            {
              "const": "128",
              "title": "128 kbps"
            },
            {
              "const": "160",
              "title": "160 kbps"
            },
            {
              "const": "192",
              "title": "192 kbps"
            },
            {
              "const": "224",
              "title": "224 kbps"
            },
            {
              "const": "256",
              "title": "256 kbps"
            },
            {
              "const": "320",
              "title": "320 kbps"
            }
          ]
        },
        "min_votes": {
          "type": "integer",
          "title": "Minimum votes",
          "description": "Skip stations with fewer votes. 0 = no minimum.",
          "default": 0
        },
        "require_countrycode": {
          "type": "boolean",
          "title": "Require country code",
          "description": "Skip stations without a country code.",
          "default": false
        },
        "require_homepage": {
          "type": "boolean",
          "title": "Require homepage",
          "description": "Skip stations without a homepage. The web player fetches the favicon logo from the homepage.",
          "default": false
        },
        "require_geo": {
          "type": "boolean",
          "title": "Require geo coordinates",
          "description": "Skip stations without geo coordinates.",
          "default": false
        },
        "prune_missing": {
          "type": "boolean",
          "title": "Remove non-matching stations",
          "description": "Removes stations that no longer match the filtered set. The plugin manages the entire radio list.",
          "default": true
        }
      },
      "required": []
    },
    "uiSchema": {
      "type": "VerticalLayout",
      "elements": [
        {
          "type": "Group",
          "label": "Synchronization",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/sync_cron"
            },
            {
              "type": "Control",
              "scope": "#/properties/dry_run"
            },
            {
              "type": "Control",
              "scope": "#/properties/sync_now"
            }
          ]
        },
        {
          "type": "Group",
          "label": "Naming",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/name_template",
              "options": {
                "multi": true
              }
            }
          ]
        },
        {
          "type": "Group",
          "label": "Filters",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/hide_broken"
            },
            {
              "type": "HorizontalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/countrycodes_mode"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/countrycodes"
                }
              ]
            },
            {
              "type": "HorizontalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/tags_mode"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/tags"
                }
              ]
            },
            {
              "type": "HorizontalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/languagecodes_mode"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/languagecodes"
                }
              ]
            },
            {
              "type": "HorizontalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/codecs_mode"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/codecs"
                }
              ]
            },
            {
              "type": "HorizontalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/min_bitrate"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/min_votes"
                }
              ]
            }
          ]
        },
        {
          "type": "Group",
          "label": "Requirements",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/require_countrycode"
            },
            {
              "type": "Control",
              "scope": "#/properties/require_homepage"
            },
            {
              "type": "Control",
              "scope": "#/properties/require_geo"
            }
          ]
        },
        {
          "type": "Group",
          "label": "Behaviour",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/prune_missing"
            }
          ]
        }
      ]
    }
  },
  "permissions": {
    "http": {
      "reason": "Fetch stations from radio-browser.info.",
      "requiredHosts": [
        "de1.api.radio-browser.info",
        "de2.api.radio-browser.info",
        "nl1.api.radio-browser.info",
        "at1.api.radio-browser.info",
        "fr1.api.radio-browser.info",
        "all.api.radio-browser.info",
        "*.radio-browser.info"
      ]
    },
    "kvstore": {
      "reason": "Persist sync progress and the station ID mapping.",
      "maxSize": "64MB"
    },
    "scheduler": {
      "reason": "Run the periodic radio sync."
    },
    "taskqueue": {
      "reason": "Process stations in the background with retries.",
      "maxConcurrency": 2
    },
    "subsonicapi": {
      "reason": "Create, update and delete internet radio stations."
    },
    "users": {
      "reason": "Authorize the internal Subsonic API calls."
    }
  }
}
